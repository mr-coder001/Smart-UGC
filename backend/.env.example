# ==========================================
# Claudinary AI Platform - Backend Environment
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="Claudinary AI Platform"

# CORS (JSON Array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database
# Async connection used by FastAPI application
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/claudinary
# Sync connection used by Alembic migrations
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claudinary

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0

# Cloudinary Credentials (NEVER expose to frontend)
CLOUDINARY_CLOUD_NAME=hzkn4knr
CLOUDINARY_API_KEY=776777742267581
CLOUDINARY_API_SECRET=tXqcDJndlHP2KBMPiWFk8IhfuwI
CLOUDINARY_WEBHOOK_SECRET=

# Security & Admin Protection
ADMIN_API_KEY=dev_admin_secret_key_123

# File Upload & Rate Limiting
RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional Observability
SENTRY_DSN=
