# ==========================================
# Claudinary AI Platform - Root Environment
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="Claudinary AI Platform"

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ADMIN_API_KEY=dev_admin_secret_key_123

# Database & Cache (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=claudinary
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/claudinary
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claudinary
REDIS_URL=redis://localhost:6379/0

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_WEBHOOK_SECRET=your_webhook_secret

# Security & Admin Protection
ADMIN_API_KEY=dev_admin_secret_key_123

# File Upload & Rate Limiting
RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional Observability
SENTRY_DSN=
